# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# .env.local ne doit JAMAIS être commité (déjà ignoré par .gitignore de Next.js).

# Supabase — Project Settings > API dans votre dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé API Anthropic — https://console.anthropic.com
# Ne JAMAIS préfixer par NEXT_PUBLIC_ : cette clé ne doit être utilisée que
# côté serveur (dans app/api/*), jamais exposée au navigateur.
ANTHROPIC_API_KEY=votre_cle_api_anthropic

# --- Bêta privée (candidatures + panneau admin) ---

# Supabase — Project Settings > API > clé "service_role" (PAS la clé "anon").
# Réservée aux routes admin côté serveur, ne JAMAIS l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# L'email avec lequel VOUS vous connectez sur Compyo (créez-vous un compte
# via /login si ce n'est pas déjà fait). Seul ce compte peut accéder à
# /admin/candidatures.
ADMIN_EMAIL=votre_email@exemple.com

# URL publique de votre site, utilisée dans le lien envoyé aux artisans
# acceptés. En local :
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel — pour recevoir un email à chaque nouvelle candidature.
# Sans cette clé, les candidatures sont quand même enregistrées, vous devrez
# juste consulter /admin/candidatures manuellement. Clé sur https://resend.com
RESEND_API_KEY=

# Optionnel — adresse qui reçoit l'email de notification de candidature.
# Tant que vous n'avez pas vérifié de domaine d'envoi sur Resend, leur
# domaine de test (onboarding@resend.dev) ne peut envoyer QU'à l'adresse du
# compte Resend lui-même — qui n'est pas forcément la même qu'ADMIN_EMAIL
# (le compte avec lequel vous vous connectez sur Compyo). Si NOTIFICATION_EMAIL
# n'est pas définie, ADMIN_EMAIL est utilisée par défaut.
NOTIFICATION_EMAIL=

# Requis pour les rappels programmés (app/api/cron/rappels/route.ts) —
# n'importe quelle chaîne aléatoire longue (ex: générée avec `openssl rand
# -hex 32`). Cette route est déclenchée par un service cron EXTERNE
# (cron-job.org ou équivalent, pas Vercel Cron — voir le commentaire en tête
# de fichier de la route), qui doit envoyer cette même valeur en en-tête
# "Authorization: Bearer <CRON_SECRET>" à chaque appel programmé. Sans cette
# variable, la route refuse tout appel (503) : les rappels programmés par
# les artisans ne seront jamais envoyés tant qu'elle n'est pas définie.
CRON_SECRET=
