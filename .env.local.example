# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# .env.local ne doit JAMAIS être commité (déjà ignoré par .gitignore de Next.js).

# Supabase — Project Settings > API dans votre dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé API Anthropic — https://console.anthropic.com
# Ne JAMAIS préfixer par NEXT_PUBLIC_ : cette clé ne doit être utilisée que
# côté serveur (dans app/api/*), jamais exposée au navigateur.
ANTHROPIC_API_KEY=votre_cle_api_anthropic

# --- Bêta privée (candidatures + panneau admin) ---

# Supabase — Project Settings > API > clé "service_role" (PAS la clé "anon").
# Réservée aux routes admin côté serveur, ne JAMAIS l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# L'email avec lequel VOUS vous connectez sur Compyo (créez-vous un compte
# via /login si ce n'est pas déjà fait). Seul ce compte peut accéder à
# /admin/candidatures.
ADMIN_EMAIL=votre_email@exemple.com

# URL publique de votre site, utilisée dans le lien envoyé aux artisans
# acceptés. En local :
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel — pour recevoir un email à chaque nouvelle candidature.
# Sans cette clé, les candidatures sont quand même enregistrées, vous devrez
# juste consulter /admin/candidatures manuellement. Clé sur https://resend.com
RESEND_API_KEY=

# Optionnel — adresse qui reçoit l'email de notification de candidature.
# Tant que vous n'avez pas vérifié de domaine d'envoi sur Resend, leur
# domaine de test (onboarding@resend.dev) ne peut envoyer QU'à l'adresse du
# compte Resend lui-même — qui n'est pas forcément la même qu'ADMIN_EMAIL
# (le compte avec lequel vous vous connectez sur Compyo). Si NOTIFICATION_EMAIL
# n'est pas définie, ADMIN_EMAIL est utilisée par défaut.
NOTIFICATION_EMAIL=

# Optionnel — adresse d'envoi pour le bilan mensuel (app/api/cron/
# bilan-mensuel/route.ts). Contrairement à la notification de candidature,
# cet email part vers CHAQUE artisan, pas seulement votre propre compte —
# le domaine de test Resend (onboarding@resend.dev) ne le permet pas.
# Nécessite d'avoir vérifié un vrai domaine d'envoi sur Resend (ex :
# notifications@compyo.fr), ce qui suppose de posséder ce domaine. Tant que
# cette variable est vide, l'envoi est sauté silencieusement — le bilan
# reste consultable dans l'app sur /dashboard/bilan.
RESEND_FROM_EMAIL=

# Requis pour les rappels programmés (app/api/cron/rappels/route.ts) ET la
# relance de devis sans réponse (app/api/cron/relance-devis/route.ts) —
# n'importe quelle chaîne aléatoire longue (ex: générée avec `openssl rand
# -hex 32`). MÊME valeur pour les deux routes, mais elles doivent être
# programmées SÉPARÉMENT (deux URLs différentes) sur votre service cron
# EXTERNE (cron-job.org ou équivalent, pas Vercel Cron — voir le commentaire
# en tête de fichier de chaque route), qui doit envoyer cette valeur en
# en-tête "Authorization: Bearer <CRON_SECRET>" à chaque appel programmé.
# Sans cette variable, les deux routes refusent tout appel (503).
CRON_SECRET=

# Requis pour que les notifications push (rappels de notes, relance de
# devis) partent réellement — sans ces deux clés, envoyerPush() (lib/
# notifications/push.ts) ne fait rien, silencieusement, plutôt que de
# planter. À générer UNE SEULE FOIS avec `npx web-push generate-vapid-keys`
# (aucun compte externe requis, la commande génère la paire directement).
# NEXT_PUBLIC_VAPID_CLE_PUBLIQUE est exposée au navigateur (nécessaire pour
# qu'un artisan puisse s'abonner), VAPID_CLE_PRIVEE ne doit JAMAIS l'être.
NEXT_PUBLIC_VAPID_CLE_PUBLIQUE=
VAPID_CLE_PRIVEE=

# Optionnel — email de contact affiché aux services de push (Google, etc.)
# en cas d'abus détecté depuis Compyo. Adresse générique de support, pas
# celle d'un artisan en particulier. "contact@compyo.fr" par défaut si vide.
VAPID_CONTACT_EMAIL=
